<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosbag2_dynamic_recorder</name>
  <version>0.1.0</version>
  <description>
    A rosbag2 recorder that owns its subscriptions, so the recorded topic set can be changed at
    runtime without stopping the writer or splitting the bag. Writes standard rosbag2 bags through
    rosbag2_cpp::Writer, so ros2 bag play, mcap tooling and Foxglove all keep working.

    Built on Writer rather than on rosbag2_transport::Recorder because Recorder binds its topic
    set to the static RecordOptions given at construction, and its only reconfiguration path tears
    down every subscription and closes the bag -- which is exactly the file split this package
    exists to avoid.
  </description>
  <maintainer email="jdsglez@gmail.com">juandanielsg</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Provides ament_cmake_ros_core::ament_ros_defaults, which CMakeLists links into both the
       library and the executable. Every other find_package here has a matching entry; this one
       did not. No environment has been found where the omission actually breaks a build, since
       the ros:rolling images all carry the package already, which is why it went unnoticed.
       But rosdep installs only what the manifest declares, so building was luck rather than
       specification. Same tag rosbag2_cpp itself uses. -->
  <buildtool_depend>ament_cmake_ros_core</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>rosbag2_interfaces</depend>
  <!-- For the public type_description_hash_for_topic() helper only; the Recorder itself is
       deliberately not used. -->
  <depend>rosbag2_transport</depend>
  <depend>rosbag2_dynamic_recorder_interfaces</depend>
  <depend>rmw</depend>

  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>rosbag2_py</test_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
